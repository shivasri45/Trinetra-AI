# Copy to .env and fill in before `docker compose up`. Never commit .env.
#
# Generate both keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The compose file sets TRINETRA_ENV=production, which makes the service refuse
# to start if either key is left at its development default.

# REST and WebSocket authentication. Note this value is also compiled into the
# dashboard's JavaScript bundle and is therefore readable by anyone who can load
# the page. It gates casual access, not a determined caller.
TRINETRA_API_KEY=

# Telemetry frame signing. This one is a genuine secret and never leaves the
# backend: with it, anyone can forge a valid signature over any frame and the
# integrity control at POST /security/verify becomes meaningless.
TRINETRA_HMAC_KEY=

# Hostname Caddy serves. A real domain gets an automatic Let's Encrypt
# certificate; `localhost` gets a local self-signed one.
TRINETRA_SITE_ADDRESS=localhost

# direct | can. Leave as direct: `can` with a virtual bus works, but socketcan
# needs CAN hardware that a cloud instance does not have.
TRINETRA_INGESTION=direct

# Comma-separated browser origins allowed to call the API. Leave empty for the
# same-origin setup in docker-compose.yml. Only needed when the dashboard is
# hosted separately, e.g. on CloudFront:
#   TRINETRA_CORS_ORIGINS=https://trinetra.example.com
TRINETRA_CORS_ORIGINS=
